// Anki Chinese vocab -> iOS widget (home screen + lock screen).
//
// One script serves every size: iOS reports the size in config.widgetFamily
// and the layout branches on it. Point both widgets at this same script.
//
//   Lock screen  -> the character alone, as large as the space allows.
//   Home screen  -> one character, with pinyin, full meaning and an example.
//
// Setup:
//   1. Install Scriptable from the App Store.
//   2. New script, paste this in, name it "Chinese".
//   3. Home screen:  long-press -> add Scriptable widget -> pick "Chinese".
//      Lock screen:  Customize -> add widget -> Scriptable -> pick "Chinese".
//
// The displayed word rotates on a fixed schedule derived from the clock, so it
// changes on its own even when iOS declines to refresh the widget.

const GIST_RAW_URL =
  "https://gist.githubusercontent.com/ankur-ag/6948afe26e45742f6d5cec3c8fae8f4f/raw/widget.json";

// How often the shown word advances. The lock screen and home screen widgets
// derive their word from the same clock slot, so they always stay in sync.
const ROTATE_MINUTES = 60;

// iOS renders lock screen widgets in "vibrant" mode: everything is desaturated
// to a single tint, so tone colours cannot survive there (see notes below).
// The tone mark itself still carries the tone; flip this on to additionally
// spell it out as a digit, e.g. hǎo3.
const LOCK_TONE_DIGITS = false;

// Matches anki/tocfl_single_chars/styling.css and app/components/PinyinText.tsx:
// 1=red 2=green 3=blue 4=purple 5=gray.
const TONE_COLORS = [
  Color.dynamic(new Color("#6b7280"), new Color("#9ca3af")), // 0 / unknown
  Color.dynamic(new Color("#dc2626"), new Color("#f87171")), // 1
  Color.dynamic(new Color("#008000"), new Color("#00c000")), // 2
  Color.dynamic(new Color("#0000ff"), new Color("#4444ff")), // 3
  Color.dynamic(new Color("#9333ea"), new Color("#c084fc")), // 4
  Color.dynamic(new Color("#6b7280"), new Color("#9ca3af")), // 5 neutral
];

const CACHE = FileManager.local();
const CACHE_PATH = CACHE.joinPath(CACHE.cacheDirectory(), "anki-widget.json");

async function loadCards() {
  try {
    const req = new Request(`${GIST_RAW_URL}?v=${Date.now()}`);
    req.timeoutInterval = 10;
    const data = await req.loadJSON();
    if (data && Array.isArray(data.cards) && data.cards.length) {
      CACHE.writeString(CACHE_PATH, JSON.stringify(data));
      return data.cards;
    }
  } catch (e) {
    // Network failure is expected sometimes; fall through to the cache so the
    // widget shows the last known word instead of an error.
  }
  if (CACHE.fileExists(CACHE_PATH)) {
    return JSON.parse(CACHE.readString(CACHE_PATH)).cards;
  }
  return [];
}

const ROTATE_MS = ROTATE_MINUTES * 60 * 1000;

function currentSlot() {
  return Math.floor(Date.now() / ROTATE_MS);
}

function pick(cards) {
  return cards[currentSlot() % cards.length];
}

function line(container, text, size, color, bold) {
  const t = container.addText(text);
  t.font = bold ? Font.boldSystemFont(size) : Font.systemFont(size);
  t.textColor = color;
  return t;
}

// Pinyin laid out syllable by syllable so each can take its own tone colour.
// Falls back to the plain string when the exporter could not split it.
function tonedPinyin(container, card, size, fallbackColor, centered) {
  const row = container.addStack();
  row.layoutHorizontally();
  if (centered) row.addSpacer();

  if (!card.syl || !card.syl.length) {
    const t = line(row, card.p || "", size, fallbackColor, false);
    t.lineLimit = 1;
    t.minimumScaleFactor = 0.6;
  } else {
    for (const [syllable, tone] of card.syl) {
      const color = fallbackColor || TONE_COLORS[tone] || TONE_COLORS[0];
      const t = line(row, syllable, size, fallbackColor || TONE_COLORS[tone], false);
      t.lineLimit = 1;
      t.minimumScaleFactor = 0.6;
      if (LOCK_TONE_DIGITS && fallbackColor) {
        const d = line(row, String(tone), size * 0.7, fallbackColor, false);
        d.lineLimit = 1;
      }
      row.addSpacer(3);
    }
  }

  if (centered) row.addSpacer();
  return row;
}

// The headword, one text per character so each can take its tone colour.
//
// Each character is laid out separately, so a single auto-shrinking text can no
// longer keep a long word inside the column. The point size is therefore
// derived from the character count against the space available, and
// minimumScaleFactor stays on only as a backstop.
function bigHanzi(container, card, baseSize, availableWidth, forcedColor) {
  const chars = card.tt && card.tt.length ? card.tt : null;
  const count = chars ? chars.length : card.t.length;
  const size = Math.min(baseSize, Math.floor((availableWidth * 0.95) / Math.max(count, 1)));

  const row = container.addStack();
  row.layoutHorizontally();
  row.addSpacer();

  if (!chars) {
    const t = line(row, card.t, size, forcedColor || TONE_COLORS[0], true);
    t.lineLimit = 1;
    t.minimumScaleFactor = 0.35;
  } else {
    for (const [char, tone] of chars) {
      // tone 0 marks punctuation such as the slash in 伯伯/伯: leave it neutral.
      const color = forcedColor || (tone ? TONE_COLORS[tone] : TONE_COLORS[0]);
      const t = line(row, char, size, color, true);
      t.lineLimit = 1;
      t.minimumScaleFactor = 0.35;
    }
  }

  row.addSpacer();
  return row;
}

const family = config.widgetFamily || "medium";
const isAccessory = family.startsWith("accessory");
const cards = await loadCards();
const w = new ListWidget();

if (!cards.length) {
  w.addText("Open Anki on Mac").font = Font.systemFont(12);
} else if (isAccessory) {
  // ---- Lock screen: character only ------------------------------------
  // Rendered monochrome and tinted by iOS, so plain white with no background.
  w.backgroundColor = new Color("#000000", 0);
  w.setPadding(0, 0, 0, 0);
  const white = Color.white();
  const card = pick(cards);

  if (family === "accessoryInline") {
    // Inline sits beside the clock: one short line, no styling control.
    w.addText(card.p ? `${card.t} ${card.p}` : card.t);
  } else if (family === "accessoryCircular") {
    // ~72x72: no room for pinyin alongside, so the character keeps the space.
    const outer = w.addStack();
    outer.layoutVertically();
    outer.addSpacer();
    bigHanzi(outer, card, 40, 66, white);
    outer.addSpacer();
  } else {
    // accessoryRectangular (~160x72): character large, pinyin beneath it.
    // Tone colours are stripped by vibrant rendering, so the tone marks (and
    // optionally LOCK_TONE_DIGITS) carry the tone instead.
    const outer = w.addStack();
    outer.layoutVertically();
    outer.addSpacer();
    bigHanzi(outer, card, 38, 150, white);
    outer.addSpacer(2);
    tonedPinyin(outer, card, 13, white, true);
    outer.addSpacer();
  }
} else {
  // ---- Home screen: one word, in detail --------------------------------
  w.setPadding(14, 14, 14, 14);
  w.backgroundColor = Color.dynamic(new Color("#ffffff"), new Color("#1c1c1e"));
  const fg = Color.dynamic(new Color("#111111"), new Color("#f2f2f7"));
  const muted = Color.dynamic(new Color("#6b7280"), new Color("#9ca3af"));
  const card = pick(cards);
  const ex = card.ex;

  if (family === "small") {
    // ~160x160: no room for an example sentence, so character and gloss only.
    const stack = w.addStack();
    stack.layoutVertically();
    stack.addSpacer();
    bigHanzi(stack, card, 46, 132, null);
    if (card.p) {
      stack.addSpacer(4);
      tonedPinyin(stack, card, 14, null, true);
    }
    stack.addSpacer(3);
    const m = line(stack, card.m, 12, fg, false);
    m.centerAlignText();
    m.lineLimit = 3;
    m.minimumScaleFactor = 0.7;
    stack.addSpacer();
  } else {
    // medium/large are full width, so the character sits on the left and the
    // detail column uses the remaining space rather than stacking under it.
    const isLarge = family === "large";
    const cols = w.addStack();
    cols.layoutHorizontally();
    cols.centerAlignContent();

    const left = cols.addStack();
    left.layoutVertically();
    left.size = new Size(isLarge ? 130 : 108, 0);
    left.addSpacer();
    bigHanzi(left, card, isLarge ? 68 : 54, isLarge ? 130 : 108, null);
    if (card.p) {
      left.addSpacer(4);
      tonedPinyin(left, card, isLarge ? 15 : 13, null, true);
    }
    left.addSpacer();

    cols.addSpacer(12);

    const right = cols.addStack();
    right.layoutVertically();
    right.addSpacer();

    // Full meaning, untrimmed -- the detail column has room for it.
    const m = line(right, card.m, isLarge ? 15 : 13, fg, false);
    m.lineLimit = isLarge ? 4 : 3;
    m.minimumScaleFactor = 0.7;

    if (ex && ex.zh) {
      right.addSpacer(8);
      const rule = right.addStack();
      rule.size = new Size(0, 1);
      rule.backgroundColor = muted;
      right.addSpacer(8);

      const zh = line(right, ex.zh, isLarge ? 16 : 14, fg, false);
      zh.lineLimit = 2;
      zh.minimumScaleFactor = 0.7;

      if (isLarge && ex.py) {
        right.addSpacer(2);
        const py = line(right, ex.py, 12, muted, false);
        py.lineLimit = 1;
        py.minimumScaleFactor = 0.7;
      }
      if (ex.en) {
        right.addSpacer(2);
        const en = line(right, ex.en, isLarge ? 13 : 11, muted, false);
        en.lineLimit = 2;
        en.minimumScaleFactor = 0.7;
      }
    }
    right.addSpacer();
  }
}

// Ask iOS to refresh just after the next rotation boundary rather than on a
// blind interval, so the word turns over close to on time. iOS treats this as
// a hint and applies its own throttling, so a late change is still possible.
w.refreshAfterDate = new Date((currentSlot() + 1) * ROTATE_MS + 5000);

if (config.runsInWidget) {
  Script.setWidget(w);
} else {
  await w.presentMedium();
}
Script.complete();
